modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.production]
APP_URL = "https://enviroiq.net"
RP_ID = "enviroiq.net"
ORIGIN = "https://enviroiq.net"
FROM_EMAIL = "EnviroIQ <noreply@enviroiq.net>"
INBOUND_EMAIL_DOMAIN = "enviroiq.net"

[userenv.shared]
SUPER_ADMIN_EMAIL = "ulrich@edgeops.nz"
INBOUND_EMAIL_WEBHOOK_SECRET = "242aa128e9233da8683810111e5a25455f96da918a9db13f036a10df921ef35a"
FUELSAVER_LOGIN = "03AEDCD4"
